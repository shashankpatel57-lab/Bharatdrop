<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FileSetuDesktop</AssemblyName>
    <RootNamespace>FileSetuDesktop</RootNamespace>
    <Product>FileSetu Desktop</Product>
    <Company>FileSetu</Company>
    <Description>High-speed local PC and phone file transfer</Description>
    <Version>5.4.0</Version>
    <FileVersion>5.4.0.0</FileVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
</Project>
